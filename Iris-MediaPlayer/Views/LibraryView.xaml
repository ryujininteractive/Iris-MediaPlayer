<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Iris_MediaPlayer.Views"
    xmlns:controls="using:Iris_MediaPlayer.Views.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="VideoCardTemplate">
            <Button Style="{StaticResource IrisCardButtonStyle}" Tag="{Binding FilePath}" Click="MediaCard_Click"
                    ContextRequested="VideoCard_ContextRequested">
                <controls:MediaCard />
            </Button>
        </DataTemplate>

        <!-- Folder and collection cards. The menu is built per card in code (TileMore_Click / Tile_ContextRequested). -->
        <DataTemplate x:Key="TileTemplate">
            <Grid PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                <Button Style="{StaticResource IrisSurfaceCardButtonStyle}" Tag="{Binding}" Click="Tile_Click"
                        ContextRequested="Tile_ContextRequested">
                    <controls:TileCard />
                </Button>
                <Button Style="{StaticResource IrisOverflowButtonStyle}" Margin="0,12,12,0" Opacity="0"
                        Click="TileMore_Click" ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>

        <!-- The dashed card at the end of the collections grid. -->
        <DataTemplate x:Key="NewCollectionTemplate">
            <Button Style="{StaticResource IrisCardButtonStyle}" Padding="0" Click="CreateCollection_Click"
                    AutomationProperties.Name="New collection">
                <Grid MinHeight="228">
                    <Rectangle RadiusX="18" RadiusY="18" StrokeThickness="1" StrokeDashArray="4,3"
                               Stroke="{StaticResource IrisStrokeStrongBrush}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Center"
                                Background="{StaticResource IrisAccentSoftBrush}">
                            <FontIcon Glyph="&#xE710;" FontSize="20" Foreground="{StaticResource IrisAccentLightBrush}" />
                        </Border>
                        <TextBlock Text="New collection" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource IrisTextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <local:TileTemplateSelector x:Key="TileTemplateSelector"
                                    Tile="{StaticResource TileTemplate}"
                                    NewCollection="{StaticResource NewCollectionTemplate}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, summary, filter and this tab's main action -->
        <Grid Margin="48,32,40,0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6" VerticalAlignment="Bottom">
                <TextBlock x:Name="PageTitle" Text="Library" Style="{StaticResource IrisPageTitleTextStyle}" />
                <TextBlock x:Name="PageSummary" Style="{StaticResource IrisBodySecondaryTextStyle}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <Grid Width="280">
                    <TextBox x:Name="FilterBox" Style="{StaticResource IrisFilterTextBoxStyle}"
                             PlaceholderText="Filter library" TextChanged="FilterBox_TextChanged"
                             AutomationProperties.Name="Filter library">
                        <TextBox.Resources>
                            <StaticResource x:Key="TextControlBackground" ResourceKey="IrisFieldBrush" />
                            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="IrisRaisedBrush" />
                            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="IrisRaisedBrush" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#12FFFFFF" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#24FFFFFF" />
                            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="IrisAccentFocusStrokeBrush" />
                            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="IrisTextTertiaryBrush" />
                            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="IrisTextTertiaryBrush" />
                            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="IrisTextTertiaryBrush" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                    <FontIcon Glyph="&#xE721;" FontSize="14" Margin="15,0,0,0" HorizontalAlignment="Left"
                              VerticalAlignment="Center" IsHitTestVisible="False"
                              Foreground="{StaticResource IrisTextSecondaryBrush}" />
                </Grid>
                <Button x:Name="PrimaryActionButton" Style="{StaticResource IrisPrimarySmallButtonStyle}" Click="PrimaryAction_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock x:Name="PrimaryActionText" Text="Add folder" />
                    </StackPanel>
                </Button>
                <Button x:Name="EditCollectionButton" Style="{StaticResource IrisOutlineButtonStyle}" Click="EditCollectionVideos_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                        <TextBlock Text="Edit videos" />
                    </StackPanel>
                </Button>
                <Button x:Name="CollectionMoreButton" Style="{StaticResource IrisOutlineButtonStyle}" Padding="0" Width="38"
                        Click="CollectionMore_Click" ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tabs, then this tab's filters or breadcrumb -->
        <Grid Grid.Row="1" Margin="48,22,40,14" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Segmented x:Name="Tabs" SegmentWidth="120" SelectionChanged="Tabs_SelectionChanged"
                                AutomationProperties.Name="Library view" />

            <StackPanel x:Name="VideoFilters" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <ToggleButton x:Name="AllChip" Content="All" Tag="All" Style="{StaticResource IrisChipToggleStyle}" Click="Chip_Click" IsChecked="True" />
                <ToggleButton x:Name="UhdChip" Content="4K" Tag="4K" Style="{StaticResource IrisChipToggleStyle}" Click="Chip_Click" />
                <ToggleButton x:Name="InProgressChip" Content="In progress" Tag="InProgress" Style="{StaticResource IrisChipToggleStyle}" Click="Chip_Click" />
                <ToggleButton x:Name="UnwatchedChip" Content="Unwatched" Tag="Unwatched" Style="{StaticResource IrisChipToggleStyle}" Click="Chip_Click" />
                <Border Width="1" Height="22" Margin="6,0" Background="{StaticResource IrisStrokeStrongBrush}" />
                <Button x:Name="SortButton" Style="{StaticResource IrisOutlineButtonStyle}" Height="32" Padding="14,0"
                        FontSize="13" FontWeight="Medium">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="SortButtonText" Text="Sort: Name" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="SortByName" Text="Name" GroupName="Sort" Tag="Name" IsChecked="True" Click="Sort_Click" />
                            <RadioMenuFlyoutItem Text="Recently added" GroupName="Sort" Tag="Added" Click="Sort_Click" />
                            <RadioMenuFlyoutItem Text="Folder" GroupName="Sort" Tag="Folder" Click="Sort_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <BreadcrumbBar x:Name="Breadcrumb" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="Collapsed" ItemClicked="Breadcrumb_ItemClicked" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel Spacing="24" Padding="40,0,32,32">
                    <StackPanel x:Name="TilesSection" Spacing="10">
                        <TextBlock x:Name="TilesHeader" Text="Folders" Margin="8,0" Style="{StaticResource IrisSectionTitleTextStyle}" />
                        <ItemsRepeater x:Name="TileItems" ItemTemplate="{StaticResource TileTemplateSelector}"
                                       ElementPrepared="Items_ElementPrepared" Margin="8,6,8,0">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="248" ItemsStretch="Fill" MinColumnSpacing="16" MinRowSpacing="16" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel x:Name="VideosSection" Spacing="6">
                        <TextBlock x:Name="VideosHeader" Text="Videos" Margin="8,0" Style="{StaticResource IrisSectionTitleTextStyle}" />
                        <ItemsRepeater x:Name="VideoItems" ItemTemplate="{StaticResource VideoCardTemplate}"
                                       ElementPrepared="Items_ElementPrepared">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="232" ItemsStretch="Fill" MinColumnSpacing="4" MinRowSpacing="4" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <controls:EmptyState x:Name="EmptyMessage" Visibility="Collapsed" Margin="0,0,0,80"
                                 ActionClick="EmptyMessage_ActionClick" />
        </Grid>
    </Grid>
</UserControl>
