<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.JellyfinView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:jf="using:Iris_MediaPlayer.Views.Jellyfin"
    xmlns:controls="using:Iris_MediaPlayer.Views.Controls">

    <Grid>
        <!-- Signed in: the media center. Pages sit under a floating bar. -->
        <Grid x:Name="BrowseRoot" Visibility="Collapsed">
            <jf:JellyfinHomeView x:Name="HomePage" />
            <jf:JellyfinLibraryView x:Name="LibraryPage" Visibility="Collapsed" />
            <jf:JellyfinDetailsView x:Name="DetailsPage" Visibility="Collapsed" />

            <Grid x:Name="TopBar" VerticalAlignment="Top" Margin="40,20,32,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ServerButton" Style="{StaticResource IrisGlassPillButtonStyle}" Padding="8,0,14,0"
                        AutomationProperties.Name="Server and account">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="24" Height="24" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFAA5CC3" Offset="0" />
                                    <GradientStop Color="#FF00A4DC" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="ServerNameText" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                        <Ellipse Width="7" Height="7" Fill="#FF5BD69A" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="ServerMenuFlyout" Placement="BottomEdgeAlignedLeft" Opening="ServerMenu_Opening" />
                    </Button.Flyout>
                </Button>

                <Button x:Name="BackButton" Style="{StaticResource IrisGlassPillButtonStyle}" Click="Back_Click" Visibility="Collapsed"
                        AutomationProperties.Name="Back">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        <TextBlock x:Name="BackText" Text="Back" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="1" CornerRadius="23" Padding="0" Background="{StaticResource IrisPillBrush}">
                    <controls:Segmented x:Name="Tabs" IsPill="True" SegmentWidth="112" SegmentHeight="34"
                                        SelectionChanged="Tabs_SelectionChanged" AutomationProperties.Name="Jellyfin sections" />
                </Border>

                <Button Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource IrisGlassPillButtonStyle}" Width="38" Padding="0"
                        Click="Refresh_Click" ToolTipService.ToolTip="Load again from the server" AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <controls:EmptyState x:Name="BrowseMessage" Visibility="Collapsed" Margin="0,120,0,80" ActionClick="BrowseMessage_ActionClick" />
        </Grid>

        <!-- Connecting and signing in: one centred card that changes step by step -->
        <Grid x:Name="SignInRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="48,32,40,0" Spacing="6">
                <TextBlock Text="Jellyfin" Style="{StaticResource IrisPageTitleTextStyle}" />
                <TextBlock Text="Stream films and shows from your Jellyfin server." Style="{StaticResource IrisBodySecondaryTextStyle}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border MaxWidth="460" Margin="40,40,40,40" Padding="32,28" CornerRadius="18" VerticalAlignment="Top"
                        Background="{StaticResource IrisSurfaceBrush}" BorderBrush="{StaticResource IrisStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="StepTitle" Text="Connect to your server" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="StepCaption" Style="{StaticResource IrisBodySecondaryTextStyle}" TextWrapping="Wrap"
                                       Text="Type the address you use to open Jellyfin in a browser." />
                        </StackPanel>

                        <StackPanel x:Name="AddressStep" Spacing="14">
                            <TextBox x:Name="AddressBox" Header="Server address" PlaceholderText="http://192.168.1.10:8096"
                                     CornerRadius="10" KeyDown="AddressBox_KeyDown" IsSpellCheckEnabled="False" />
                            <Button x:Name="ConnectButton" Style="{StaticResource IrisPrimaryButtonStyle}" HorizontalAlignment="Stretch"
                                    Content="Connect" Click="Connect_Click" />
                            <HyperlinkButton x:Name="CancelAddButton" Content="Cancel" HorizontalAlignment="Center" Click="CancelAdd_Click"
                                             Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel x:Name="SignInStep" Spacing="14" Visibility="Collapsed">
                            <TextBox x:Name="UserNameBox" Header="Username" CornerRadius="10" IsSpellCheckEnabled="False" />
                            <PasswordBox x:Name="PasswordBox" Header="Password" CornerRadius="10" KeyDown="PasswordBox_KeyDown" />
                            <Button x:Name="SignInButton" Style="{StaticResource IrisPrimaryButtonStyle}" HorizontalAlignment="Stretch"
                                    Content="Sign in" Click="SignIn_Click" />
                            <Button x:Name="QuickConnectButton" Style="{StaticResource IrisOutlineButtonStyle}" HorizontalAlignment="Stretch"
                                    Click="QuickConnect_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="13" />
                                    <TextBlock Text="Use Quick Connect instead" />
                                </StackPanel>
                            </Button>
                            <HyperlinkButton Content="Use a different server" Click="ChangeServer_Click" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="QuickConnectStep" Spacing="14" Visibility="Collapsed">
                            <Border CornerRadius="14" Padding="0,18" Background="{StaticResource IrisRaisedBrush}">
                                <TextBlock x:Name="QuickConnectCode" FontSize="40" FontWeight="SemiBold" CharacterSpacing="300"
                                           HorizontalAlignment="Center" IsTextSelectionEnabled="True" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <ProgressRing Width="16" Height="16" IsActive="True" />
                                <TextBlock Text="Waiting for approval…" Style="{StaticResource IrisBodySecondaryTextStyle}" />
                            </StackPanel>
                            <Button Style="{StaticResource IrisOutlineButtonStyle}" HorizontalAlignment="Stretch"
                                    Content="Cancel" Click="CancelQuickConnect_Click" />
                        </StackPanel>

                        <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" IsOpen="False" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
