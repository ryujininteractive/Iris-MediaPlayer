<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.Stash.StashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:stash="using:Iris_MediaPlayer.Views.Stash"
    xmlns:controls="using:Iris_MediaPlayer.Views.Controls">

    <Grid>
        <!-- Connected: Home, Scenes, Performers, Studios and Tags under a floating bar. -->
        <Grid x:Name="BrowseRoot" Visibility="Collapsed">
            <stash:StashHomeView x:Name="HomePage" />
            <stash:StashBrowseView x:Name="BrowsePage" Visibility="Collapsed" />
            <stash:StashSceneView x:Name="ScenePage" Visibility="Collapsed" />

            <Grid VerticalAlignment="Top" Margin="40,20,32,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ServerButton" Style="{StaticResource IrisGlassPillButtonStyle}" Padding="8,0,14,0"
                        AutomationProperties.Name="Server">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Width="24" Height="24" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF4A5BD6" Offset="0" />
                                    <GradientStop Color="#FF2B2F45" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <FontIcon Glyph="&#xE8F1;" FontSize="12" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="ServerNameText" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                        <Ellipse Width="7" Height="7" Fill="#FF5BD69A" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="ServerMenuFlyout" Placement="BottomEdgeAlignedLeft" Opening="ServerMenu_Opening" />
                    </Button.Flyout>
                </Button>

                <Button x:Name="BackButton" Style="{StaticResource IrisGlassPillButtonStyle}" Click="Back_Click" Visibility="Collapsed"
                        AutomationProperties.Name="Back">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        <TextBlock x:Name="BackText" Text="Back" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="1" CornerRadius="23" Background="{StaticResource IrisPillBrush}">
                    <controls:Segmented x:Name="Tabs" IsPill="True" SegmentWidth="112" SegmentHeight="34"
                                        SelectionChanged="Tabs_SelectionChanged" AutomationProperties.Name="Stash sections" />
                </Border>

                <Button Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource IrisGlassPillButtonStyle}" Width="38" Padding="0"
                        Click="Refresh_Click" ToolTipService.ToolTip="Load again from Stash" AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>
        </Grid>

        <!-- Not connected: address and (if Stash asks for one) API key. -->
        <Grid x:Name="ConnectRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="48,32,40,0" Spacing="6">
                <TextBlock Text="Stash" Style="{StaticResource IrisPageTitleTextStyle}" />
                <TextBlock Text="Browse and play your Stash library." Style="{StaticResource IrisBodySecondaryTextStyle}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border MaxWidth="460" Margin="40" Padding="32,28" CornerRadius="18" VerticalAlignment="Top"
                        Background="{StaticResource IrisSurfaceBrush}" BorderBrush="{StaticResource IrisStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Connect to Stash" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource IrisBodySecondaryTextStyle}" TextWrapping="Wrap"
                                       Text="Type the address you use to open Stash in a browser. If Stash has a password, add an API key from Settings › Security in Stash." />
                        </StackPanel>
                        <TextBox x:Name="AddressBox" Header="Server address" PlaceholderText="http://192.168.1.10:9999" CornerRadius="10"
                                 IsSpellCheckEnabled="False" KeyDown="Field_KeyDown" />
                        <PasswordBox x:Name="ApiKeyBox" Header="API key (if Stash has a password)" CornerRadius="10" KeyDown="Field_KeyDown" />
                        <TextBox x:Name="NameBox" Header="Name (optional)" PlaceholderText="Stash" CornerRadius="10" KeyDown="Field_KeyDown" />
                        <Button x:Name="ConnectButton" Style="{StaticResource IrisPrimaryButtonStyle}" HorizontalAlignment="Stretch"
                                Content="Connect" Click="Connect_Click" />
                        <HyperlinkButton x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Center" Click="Cancel_Click" />
                        <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" IsOpen="False" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
