<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Iris_MediaPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Iris_MediaPlayer.Views"
    Title="Iris">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        Shell: title bar across the top, the navigation rail on the left (Mica shows through both),
        and the content surface with its rounded top-left corner. The player takes over the whole
        area below the title bar; fullscreen and the mini player hide the title bar too.
    -->
    <Grid x:Name="WindowRoot"
          KeyboardAcceleratorPlacementMode="Hidden"
          AllowDrop="True"
          DragEnter="App_DragEnter"
          DragOver="App_DragOver"
          DragLeave="App_DragLeave"
          Drop="App_Drop">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar (draggable; the caption buttons are drawn by Windows on the right) -->
        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Padding="18,0,0,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M2,12 C5,7 9,5 12,5 C15,5 19,7 22,12 C19,17 15,19 12,19 C9,19 5,17 2,12 Z"
                              Stroke="{StaticResource IrisAccentLightBrush}" StrokeThickness="1.8" />
                        <Ellipse Canvas.Left="8.8" Canvas.Top="8.8" Width="6.4" Height="6.4"
                                 Fill="{StaticResource IrisAccentLightBrush}" />
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="TitleBarText" Text="Iris" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource IrisTextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Navigation rail. One plate slides behind the selected item (the "Selection slide"). -->
        <Grid x:Name="Rail" Grid.Row="1" Padding="0,12,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="RailSelection" Grid.RowSpan="3" Width="48" Height="48" CornerRadius="12"
                    VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False"
                    Background="{StaticResource IrisAccentSoftBrush}" />
            <Border x:Name="RailIndicator" Grid.RowSpan="3" Width="3" Height="20" CornerRadius="1.5"
                    VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,14,0,0" IsHitTestVisible="False"
                    Background="{StaticResource IrisAccentBrush}" />

            <StackPanel Spacing="6">
                <Button x:Name="HomeRailButton" Style="{StaticResource IrisRailButtonStyle}" Click="RailButton_Click"
                        Tag="Home" ToolTipService.ToolTip="Home" AutomationProperties.Name="Home">
                    <FontIcon Glyph="&#xE80F;" FontSize="20" />
                </Button>
                <Button x:Name="LibraryRailButton" Style="{StaticResource IrisRailButtonStyle}" Click="RailButton_Click"
                        Tag="Library" ToolTipService.ToolTip="Library" AutomationProperties.Name="Library">
                    <FontIcon Glyph="&#xE8B2;" FontSize="20" />
                </Button>
                <Button x:Name="JellyfinRailButton" Style="{StaticResource IrisRailButtonStyle}" Click="RailButton_Click"
                        Tag="Jellyfin" ToolTipService.ToolTip="Media servers" AutomationProperties.Name="Media servers">
                    <FontIcon Glyph="&#xE774;" FontSize="20" />
                </Button>
            </StackPanel>
            <Button x:Name="SettingsRailButton" Grid.Row="2" Style="{StaticResource IrisRailButtonStyle}" Click="RailButton_Click"
                    Tag="Settings" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="20" />
            </Button>
        </Grid>

        <!-- Content surface -->
        <Border x:Name="ContentSurface" Grid.Row="1" Grid.Column="1"
                CornerRadius="16,0,0,0"
                Background="{StaticResource IrisBackgroundBrush}"
                BorderBrush="{StaticResource IrisStrokeSubtleBrush}"
                BorderThickness="1,1,0,0">
            <Grid x:Name="ContentRoot" SizeChanged="ContentRoot_SizeChanged">
                <!-- One section is visible at a time; see MainWindow.ShowSection. -->
                <views:HomeView x:Name="HomePage" />
                <views:LibraryView x:Name="LibraryPage" Visibility="Collapsed" />
                <views:PlaceholderView x:Name="PlaceholderPage" Visibility="Collapsed" />
                <views:ServersView x:Name="ServersPage" Visibility="Collapsed" />
                <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />

                <!-- Floating search and Open file, over Home's artwork. -->
                <Grid x:Name="TopBar" VerticalAlignment="Top" Padding="40,20,32,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="SearchHost" Grid.Column="1" Width="440">
                        <AutoSuggestBox x:Name="SearchBox"
                                        PlaceholderText="Search videos, folders and collections"
                                        TextMemberPath="Title"
                                        CornerRadius="21"
                                        TextChanged="SearchBox_TextChanged"
                                        QuerySubmitted="SearchBox_QuerySubmitted"
                                        GotFocus="SearchBox_GotFocus"
                                        LostFocus="SearchBox_LostFocus"
                                        AutomationProperties.Name="Search">
                            <AutoSuggestBox.Resources>
                                <StaticResource x:Key="TextControlBackground" ResourceKey="IrisSearchRestBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="IrisSearchHoverBrush" />
                                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="IrisSearchFocusBrush" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="#14FFFFFF" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#24FFFFFF" />
                                <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="IrisAccentFocusStrokeBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="IrisTextTertiaryBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="IrisTextTertiaryBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="IrisTextTertiaryBrush" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                            </AutoSuggestBox.Resources>
                            <AutoSuggestBox.TextBoxStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
                                    <Setter Property="MinHeight" Value="42" />
                                    <Setter Property="Padding" Value="40,10,64,0" />
                                    <Setter Property="CornerRadius" Value="21" />
                                </Style>
                            </AutoSuggestBox.TextBoxStyle>
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,6" Spacing="2">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource IrisCaptionTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                        <FontIcon Glyph="&#xE721;" FontSize="15" Margin="16,0,0,0" HorizontalAlignment="Left"
                                  VerticalAlignment="Top" IsHitTestVisible="False" Height="42"
                                  Foreground="{StaticResource IrisTextSecondaryBrush}" />
                        <Border x:Name="SearchShortcutHint" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,11,14,0" Padding="6,3" CornerRadius="6" IsHitTestVisible="False"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <TextBlock Text="Ctrl K" FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource IrisTextTertiaryBrush}" />
                        </Border>
                    </Grid>
                    <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource IrisGhostButtonStyle}" Height="40" Padding="16,0" FontSize="14"
                            Click="OpenVideo_Click" ToolTipService.ToolTip="Play a video file without adding it to your library (Ctrl+O)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                            <TextBlock Text="Open file" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Shown once a new version has downloaded; the player covers it while a video plays. -->
                <Border x:Name="UpdateCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,32,32" Padding="16,14,14,14" CornerRadius="18" MaxWidth="520"
                        Background="{StaticResource IrisSurfaceBrush}"
                        BorderBrush="{StaticResource IrisStrokeStrongBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="12" VerticalAlignment="Center"
                                Background="{StaticResource IrisAccentSoftBrush}">
                            <FontIcon Glyph="&#xE896;" FontSize="17" Foreground="{StaticResource IrisAccentLightBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateTitle" Text="Update ready" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Restart now, or it installs the next time you open Iris." TextWrapping="Wrap"
                                       Style="{StaticResource IrisCaptionTextStyle}" Foreground="{StaticResource IrisTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Later" Style="{StaticResource IrisCtaQuietButtonStyle}" Click="UpdateLater_Click" />
                            <Button Content="Restart" Style="{StaticResource IrisCtaPrimaryButtonStyle}" Click="UpdateRestart_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <views:PlayerView x:Name="PlayerPage" Visibility="Collapsed" />

                <Border x:Name="DropOverlay" Visibility="Collapsed" Margin="24" CornerRadius="22"
                        BorderBrush="{StaticResource IrisAccentStrokeBrush}" BorderThickness="2"
                        Background="{StaticResource IrisToastBrush}" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                                Background="{StaticResource IrisAccentSoftBrush}">
                            <FontIcon Glyph="&#xE8E5;" FontSize="30" Foreground="{StaticResource IrisAccentLightBrush}" />
                        </Border>
                        <TextBlock Text="Drop a video to play instantly" Style="{StaticResource IrisSectionTitleTextStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="It won’t be added to your folders or library."
                                   HorizontalAlignment="Center" Style="{StaticResource IrisBodySecondaryTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
