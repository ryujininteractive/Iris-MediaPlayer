<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Iris_MediaPlayer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Iris.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Release builds are trimmed, which disables reflection-based System.Text.Json.
      Turning it off everywhere makes Debug fail the same way, so a JSON call that skips
      Services/IrisJsonContext.cs shows up during development instead of after publishing.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- Program.cs is the entry point, so Velopack's install hooks run before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Shown in the .exe's properties, Task Manager and the installer. -->
    <Product>Iris</Product>
    <Company>Ryujin Interactive</Company>
    <AssemblyTitle>Iris</AssemblyTitle>
    <Version>1.4.0</Version>
  </PropertyGroup>

  <!--
    Iris ships two ways, from the same code:
    - The setup (.exe) from the website: a normal desktop app installed and updated by Velopack.
    - The Microsoft Store: an MSIX package, built with -p:IrisMsix=true (see build-msix.ps1).
      The Store signs, installs and updates it; Package.appxmanifest registers the video file types.
    Both carry their own .NET and Windows App SDK runtimes, so a fresh PC needs nothing else.
    At run time Installation.IsPackaged tells them apart.
  -->
  <PropertyGroup>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IrisMsix)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      App icons in every size Windows asks for, generated from Assets\AppIcon.png (the 1000 px
      source, which is not shipped). Iris.ico is the window and .exe icon.
    -->
    <Content Include="Assets\*.png" Exclude="Assets\AppIcon.png" />
    <Content Include="Assets\Iris.ico" />
    <!-- The SDK adds image files on its own too, so remove the source explicitly. -->
    <Content Remove="Assets\AppIcon.png" />
    <None Include="Assets\AppIcon.png" />
    <!-- Iris's licence and the libraries' licences travel with the app (GPL, and Settings › Credits). -->
    <Content Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Endpne.LibMPV.Windows" Version="0.41.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <MpvWindowsX64IncludeFiles Include="libmpv-2.dll" />
    <MpvWindowsArm64IncludeFiles Include="libmpv-2.dll" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Never trimmed: trimming removes types WinUI only reaches at run time and the app crashes on start. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
