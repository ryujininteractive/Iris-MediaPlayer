<?xml version="1.0" encoding="utf-8"?>
<!--
    Obsidian: the Iris design tokens and shared styles. Every page uses these so color, type,
    shape and motion stay consistent. Iris is dark-only (see RequestedTheme in App.xaml).
    The colours below are Obsidian's; Services/Themes.cs swaps them for the chosen theme at runtime.

    Motion follows Fluent timing: 167 ms for small state changes, 250 ms for hover, 333 ms for
    selection and sheets. Templates here use XAML transitions; larger moves (hero, cards,
    sheets) use Composition through Services/Motion.cs.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent: replaces the Windows accent color so every built-in control (sliders, toggles,
         progress, focus) uses the Iris indigo. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#FF7C84F2</Color>
            <Color x:Key="SystemAccentColorLight1">#FF8B93FF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF8B93FF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFAEB4FF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF6A72E0</Color>
            <Color x:Key="SystemAccentColorDark2">#FF565DC4</Color>
            <Color x:Key="SystemAccentColorDark3">#FF4248A3</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#FF7C84F2</Color>
            <Color x:Key="SystemAccentColorLight1">#FF8B93FF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF8B93FF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFAEB4FF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF6A72E0</Color>
            <Color x:Key="SystemAccentColorDark2">#FF565DC4</Color>
            <Color x:Key="SystemAccentColorDark3">#FF4248A3</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===== Color ===== -->
    <Color x:Key="IrisWindowColor">#FF0D0E11</Color>
    <Color x:Key="IrisBackgroundColor">#FF09090B</Color>
    <Color x:Key="IrisBackgroundTransparentColor">#0009090B</Color>
    <Color x:Key="IrisAccentColor">#FF8B93FF</Color>

    <SolidColorBrush x:Key="IrisWindowBrush" Color="{StaticResource IrisWindowColor}" />
    <SolidColorBrush x:Key="IrisBackgroundBrush" Color="{StaticResource IrisBackgroundColor}" />
    <SolidColorBrush x:Key="IrisSurfaceBrush" Color="#FF111216" />
    <SolidColorBrush x:Key="IrisSurfaceHoverBrush" Color="#FF15161B" />
    <SolidColorBrush x:Key="IrisRaisedBrush" Color="#FF17181D" />
    <SolidColorBrush x:Key="IrisFieldBrush" Color="#FF141519" />
    <SolidColorBrush x:Key="IrisThumbnailBrush" Color="#FF17181D" />
    <SolidColorBrush x:Key="IrisStrokeBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="IrisStrokeSubtleBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="IrisStrokeStrongBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="IrisTextBrush" Color="#FFF4F4F6" />
    <SolidColorBrush x:Key="IrisTextSecondaryBrush" Color="#FFA1A1AA" />
    <SolidColorBrush x:Key="IrisTextTertiaryBrush" Color="#FF8A8A93" />
    <SolidColorBrush x:Key="IrisTextMutedBrush" Color="#FFC7C7CE" />
    <SolidColorBrush x:Key="IrisAccentBrush" Color="{StaticResource IrisAccentColor}" />
    <SolidColorBrush x:Key="IrisAccentHoverBrush" Color="#FFA2A8FF" />
    <SolidColorBrush x:Key="IrisAccentTextBrush" Color="#FFAEB4FF" />
    <SolidColorBrush x:Key="IrisAccentLightBrush" Color="#FFC9CDFF" />
    <SolidColorBrush x:Key="IrisAccentSoftBrush" Color="#248B93FF" />
    <SolidColorBrush x:Key="IrisAccentStrokeBrush" Color="#8C8B93FF" />
    <SolidColorBrush x:Key="IrisAccentHoverStrokeBrush" Color="#598B93FF" />
    <SolidColorBrush x:Key="IrisOnAccentBrush" Color="#FF0B0B12" />
    <SolidColorBrush x:Key="IrisOnLightBrush" Color="#FF0B0B12" />
    <SolidColorBrush x:Key="IrisLightBrush" Color="#FFF4F4F6" />
    <SolidColorBrush x:Key="IrisBadgeBrush" Color="#B8000000" />
    <SolidColorBrush x:Key="IrisTrackBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="IrisChapterGapBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="IrisPlayerIconBrush" Color="#FFE4E4E9" />
    <SolidColorBrush x:Key="IrisCardHoverBrush" Color="#0BFFFFFF" />
    <!-- Search and filter boxes, the glass pills over artwork and the drop overlay -->
    <SolidColorBrush x:Key="IrisAccentFocusStrokeBrush" Color="#998B93FF" />
    <SolidColorBrush x:Key="IrisSearchRestBrush" Color="#8C17181D" />
    <SolidColorBrush x:Key="IrisSearchHoverBrush" Color="#B317181D" />
    <SolidColorBrush x:Key="IrisSearchFocusBrush" Color="#E617181D" />
    <SolidColorBrush x:Key="IrisPillBrush" Color="#B3111216" />
    <SolidColorBrush x:Key="IrisToastBrush" Color="#E6111216" />

    <!-- Acrylic for floating chrome over video and artwork: search, player bars, sheets. -->
    <AcrylicBrush x:Key="IrisGlassBrush" TintColor="#FF121318" TintOpacity="0.62"
                  TintLuminosityOpacity="0.55" FallbackColor="#F0121318" />
    <!--
        Player controls: a see-through dark panel. Acrylic can't blur the video because mpv draws it
        on its own swap chain, which the XAML backdrop never sees, so it would only blur black.
    -->
    <SolidColorBrush x:Key="IrisControlsGlassBrush" Color="#8C0E0F13" />
    <AcrylicBrush x:Key="IrisSheetBrush" TintColor="#FF0E0F13" TintOpacity="0.82"
                  TintLuminosityOpacity="0.7" FallbackColor="#F70E0F13" />

    <!-- Dialogs may grow to a medium width (the Details dialog); smaller ones still fit their content. -->
    <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>

    <!-- ===== Layout and shape ===== -->
    <x:Double x:Key="IrisTitleBarHeight">48</x:Double>
    <x:Double x:Key="IrisRailWidth">76</x:Double>
    <x:Double x:Key="IrisTopBarHeight">82</x:Double>
    <CornerRadius x:Key="IrisCardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="IrisThumbnailCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="IrisSurfaceCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="IrisPillCornerRadius">999</CornerRadius>

    <!-- ===== Type: Segoe UI Variable ===== -->
    <FontFamily x:Key="IrisDisplayFontFamily">Segoe UI Variable Display</FontFamily>

    <Style x:Key="IrisDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IrisDisplayFontFamily}" />
        <Setter Property="FontSize" Value="52" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="56" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{StaticResource IrisTextBrush}" />
    </Style>
    <Style x:Key="IrisPageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IrisDisplayFontFamily}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{StaticResource IrisTextBrush}" />
    </Style>
    <Style x:Key="IrisSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IrisTextBrush}" />
    </Style>
    <Style x:Key="IrisBodySecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource IrisTextSecondaryBrush}" />
    </Style>
    <Style x:Key="IrisCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource IrisTextTertiaryBrush}" />
    </Style>
    <Style x:Key="IrisEyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{StaticResource IrisAccentTextBrush}" />
    </Style>
    <Style x:Key="IrisLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource IrisTextSecondaryBrush}" />
    </Style>

    <!--
        ===== Button templates =====
        Hover and press are drawn by a white overlay so one template serves every fill color.
        Pressed scales to 0.97 (the "Press" motion), with 167 ms transitions.
    -->
    <ControlTemplate x:Key="IrisButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="RootTransform" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.167">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.04" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Overlay" Background="White" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter x:Name="ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
    </ControlTemplate>

    <!-- Brighter hover for filled accent and light buttons. -->
    <ControlTemplate x:Key="IrisFilledButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="RootTransform" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.167">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Overlay" Background="White" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter x:Name="ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
    </ControlTemplate>

    <!-- Toggle version: checked shows an accent plate with an accent stroke (chips, CC, settings). -->
    <ControlTemplate x:Key="IrisToggleButtonTemplate" TargetType="ToggleButton">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5"
              Background="{TemplateBinding Background}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="RootTransform" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.167">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.04" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                        </Storyboard>
                        <VisualState.Setters>
                            <Setter Target="ContentPresenter.Foreground" Value="{StaticResource IrisAccentLightBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0" />
                        </Storyboard>
                        <VisualState.Setters>
                            <Setter Target="ContentPresenter.Foreground" Value="{StaticResource IrisAccentLightBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0" />
                        </Storyboard>
                        <VisualState.Setters>
                            <Setter Target="ContentPresenter.Foreground" Value="{StaticResource IrisAccentLightBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedDisabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border IsHitTestVisible="False"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="CheckedPlate" Opacity="0" IsHitTestVisible="False"
                    Background="{StaticResource IrisAccentSoftBrush}"
                    BorderBrush="{StaticResource IrisAccentStrokeBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="Overlay" Background="White" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter x:Name="ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
    </ControlTemplate>

    <!-- ===== Buttons ===== -->
    <Style x:Key="IrisButtonBaseStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource IrisButtonTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource IrisTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
    </Style>

    <!-- Pill, accent fill: the main action on a screen (Resume, Play, Add folder). -->
    <Style x:Key="IrisPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisButtonBaseStyle}">
        <Setter Property="Template" Value="{StaticResource IrisFilledButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource IrisAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource IrisOnAccentBrush}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>
    <Style x:Key="IrisPrimarySmallButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisPrimaryButtonStyle}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="19" />
    </Style>

    <!-- Pill, translucent white: a secondary action over artwork. -->
    <Style x:Key="IrisGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisButtonBaseStyle}">
        <Setter Property="Background" Value="#17FFFFFF" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>

    <!-- Round glass icon button beside the hero and details actions (trailer, watched, favorite). -->
    <Style x:Key="IrisRoundGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisGhostButtonStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Small glass pill over artwork: Back, the Jellyfin server chip. -->
    <Style x:Key="IrisGlassPillButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource IrisPillBrush}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0,16,0" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Pill, hairline outline: secondary actions on plain surfaces (Sort, Edit videos). -->
    <Style x:Key="IrisOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisButtonBaseStyle}">
        <Setter Property="Background" Value="#0AFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource IrisStrokeStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="19" />
    </Style>

    <!-- Small light/quiet pills used on the player's Up next card. -->
    <Style x:Key="IrisCtaPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisPrimaryButtonStyle}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style x:Key="IrisCtaQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisButtonBaseStyle}">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <!-- Round icon-only button (player controls, title bars). -->
    <Style x:Key="IrisIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisButtonBaseStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource IrisPlayerIconBrush}" />
    </Style>

    <!-- Round icon button with a hairline, e.g. the row scroll arrows on Home. -->
    <Style x:Key="IrisOutlineIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisIconButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="#08FFFFFF" />
        <Setter Property="BorderBrush" Value="#14FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource IrisTextMutedBrush}" />
    </Style>

    <!-- Small round "…" button laid over a card. -->
    <Style x:Key="IrisOverflowButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisIconButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="#A6000000" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Navigation rail item. Selection is drawn by the shell's sliding plate, not the button. -->
    <Style x:Key="IrisRailButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisButtonBaseStyle}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource IrisTextTertiaryBrush}" />
    </Style>

    <!-- Rows in the player's settings sheet (subtitle and audio tracks). -->
    <Style x:Key="IrisSheetRowButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisButtonBaseStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource IrisPlayerIconBrush}" />
    </Style>

    <!-- Square stepper buttons (− / +) in the settings sheet. -->
    <Style x:Key="IrisStepperButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisButtonBaseStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- ===== Toggles ===== -->
    <Style x:Key="IrisChipToggleStyle" TargetType="ToggleButton">
        <Setter Property="Template" Value="{StaticResource IrisToggleButtonTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource IrisStrokeStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource IrisTextMutedBrush}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
    </Style>
    <Style x:Key="IrisIconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource IrisChipToggleStyle}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource IrisPlayerIconBrush}" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <!--
        ===== Cards =====
        Transparent card: soft plate on hover, lifts 4 px (250 ms). Video cards use it; the card's own
        code zooms the artwork and reveals the play button.
    -->
    <Style x:Key="IrisCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource IrisTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="{StaticResource IrisCardCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="RootTransform" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.25">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="HoverStroke" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="TranslateY" To="-4" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="HoverStroke" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="TranslateY" To="-2" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Plate" Opacity="0" IsHitTestVisible="False" Background="{StaticResource IrisCardHoverBrush}" />
                        <Border IsHitTestVisible="False"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="HoverStroke" Opacity="0" IsHitTestVisible="False"
                                BorderBrush="{StaticResource IrisAccentHoverStrokeBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Surface card for folders and collections: raised fill, hairline that turns accent on hover. -->
    <Style x:Key="IrisSurfaceCardButtonStyle" TargetType="Button" BasedOn="{StaticResource IrisCardButtonStyle}">
        <Setter Property="Background" Value="{StaticResource IrisSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource IrisStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,16,16,14" />
        <Setter Property="CornerRadius" Value="{StaticResource IrisSurfaceCornerRadius}" />
    </Style>

    <!-- Badge on a thumbnail: quality, duration. -->
    <Style x:Key="IrisBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{StaticResource IrisBadgeBrush}" />
    </Style>

    <!-- ===== Text fields ===== -->
    <!-- Pill text box with room for a search icon on the left. -->
    <Style x:Key="IrisFilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Padding" Value="38,9,14,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
